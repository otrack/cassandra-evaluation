debug=1
# Raise one YCSB client logger to debug, e.g. site.ycsb.db.CassandraCQLClient
ycsb_debug_logger=
# CPUs given to each YCSB client container (empty = unbounded)
ycsb_cpus=8
# Seconds to wait for a YCSB client to terminate before stopping it
ycsb.client.timeout=300
# Seconds between launching the first YCSB client of a run and the moment all
# of them start together (each waits in run_benchmarks.sh's _ycsb_start_at_script); empty = 90 on real
# machines, 15 in simulation; 0 = start each as soon as it is launched.
# YCSB_START_DELAY overrides it for one run.
ycsb.start_delay=
infra=aws
ycsb_image=0track/ycsb:latest
normal_cassandra_image=0track/cassandra:latest
accord_cassandra_image=0track/cassandra-accord:latest
swiftpaxos_image=0track/swiftpaxos:latest
cockroachdb_image=0track/cockroachdb:latest
tiga_image=0track/tiga-suite:latest
node_name=database-node
network_name=database-network
latency_simulation=0
machine=e2-highcpu-16
gcp.machine=n2-standard-16
aws.machine=m5.4xlarge
aws.spot=1
accord.ephemeral_read=true
# async-profiler JFR capture of the YCSB run phase on every Cassandra node,
# including the spans emitted by Accord's DebugExecution (0=off, 1=on).
# Takes effect when the cluster is created; CASSANDRA_PROFILER=1 overrides it.
cassandra.profiler=0
# async-profiler options for the capture; jfr and file= are added.
# ctimer needs no host privileges; event=cpu (perf_events, with kernel frames)
# needs kernel.perf_event_paranoid<=1 on the host. wall keeps the spans spent
# waiting (ctimer never samples a parked thread); add nobatch to keep nearly
# all of them, at the cost of a much larger file. Add jfrsync=profile to merge
# the JDK's own events (safepoints, VM operations, ZGC page allocations and
# commits, GC pauses) into the same recording.
# CASSANDRA_PROFILER_OPTIONS overrides it.
cassandra.profiler.options=event=ctimer,interval=1ms,wall=10ms,lock=1ms
# Also log DebugExecution's slow-task/slow-lock warnings and keep its latency
# histograms while profiling. Off by default: it reads the thread CPU clock
# around every task and lock hold (~4% of executor CPU in the conflict runs,
# partly while the executor lock is held). The spans do not depend on it.
accord.debug_execution_report=false
# While profiling, also emit a "DX" span for every step of a sampled transaction's
# distributed execution (coordinator phases, messages, replica state changes,
# command store tasks), tagged with its TxnId so that all nodes' captures can be
# joined: cassandra/jfr-analysis/run.sh TxnTrace logs/profiles/<exp>/<run>_*.jfr
# 0=off, N=one transaction in N (chosen from the TxnId, so every node agrees),
# 1=all. Needs a Cassandra build with DebugDistributedExecution.
# CASSANDRA_DX overrides it for one run.
accord.debug_distributed_execution=0
# ... and record every transaction's CommandsForKey interactions on one key in
# K (1=all keys), including which transaction released each waiter ("K Unblock
# <waiter> ... by <trigger>"), so that wait chains can be followed. Independent
# of the setting above. CASSANDRA_DX_KEYS overrides it for one run.
accord.debug_distributed_execution_keys=0
# After each profiled run, summarise the slowest traced transactions and their
# wait chains into <run>_txntrace.txt next to the captures (needs a JDK 17+ on
# this machine). CASSANDRA_DX_REPORT overrides it for one run.
accord.debug_distributed_execution_report=10
# While profiling, also record Cassandra's JFR diagnostic events every 100 ms
# (-Dcassandra.jfr.diagnostic_events=true on the nodes, merged into the capture
# by async-profiler's jfrsync with cassandra/diagnostics.jfc): each internode
# connection's queue, socket backpressure and TCP_INFO (RTT, cwnd, retransmits,
# loss), the node's TCP counters, Accord executor queues, GC pauses, slow
# safepoints, and container CPU throttling. profiler.sh also snapshots the netem
# qdisc counters (drops) at the start and end of each capture. 0=off, 1=on.
# The node flag takes effect when the cluster is created; CASSANDRA_JFR_EVENTS
# overrides it for one run. Needs a Cassandra build with JfrDiagnostics.
cassandra.profiler.jfr_events=1
# Extra JVM flags for the Cassandra nodes (CASSANDRA_JVM_OPTS overrides), e.g.
#   -Daccord.debug_execution_spans=all   (with cassandra.profiler=1: emit every span, not just sampled ones)
cassandra.jvm_opts=
# One token per Cassandra node (num_tokens=1), node k of every DC owning the
# k-th of nodesperdc equal slices of the ring, as the "murmur3" partitioner of
# YCSB's Calvin micro-benchmark assumes (0=off, 1=on). Takes effect when the
# cluster is created.
cassandra.fixed_tokens=0
cockroachdb.fix_lease_holder=false
cockroachdb.range_max_bytes=536870912
# Split usertable into this many ranges of contiguous (zero-padded) keys, led by
# the nodes of the lease holder's region in turn, as the "range" partitioner of
# YCSB's Calvin micro-benchmark assumes (0 or 1=off). Takes effect when the
# table is created.
cockroachdb.partitions=0
# Calvin micro-benchmark (calvin_ubench.sh): read the records of a transaction and
# check that the sum of their counters is non-negative before incrementing them
# (true), or only increment them (false). Janus cannot evaluate the check, so it is
# skipped when the check is on. --check-invariant[=true|false] overrides it.
calvin.checkinvariant=false
# Bytes per record; the swap workload moves S of these each way
fieldlength=4000
records=100000
threads=50
maxexecutiontime=60
# Seconds every YCSB run phase executes the workload before measuring (the
# operations of the warm-up are discarded). It comes on top of
# maxexecutiontime, so both must fit within ycsb.client.timeout. The --test
# mode of the experiment scripts sets it to 0; WARMUP_EXECUTION_TIME
# overrides it for one run.
warmupexecutiontime=30
nodesperdc=1
# Lateness probes injected into the Tiga config: 0=off, 1=counters+periodic, 2=+per-txn traces
tiga.probe_lateness=0
tiga.probe_lateness_trace_cap=500
# Open-loop pump arrival process: deterministic (greedy/regular, as published)
# or poisson (exponential inter-arrival, coefficient of variation 1)
openloop_arrival=poisson
